# Copie para .env.local e preencha. O .env.local não vai para o git.

# MongoDB onde o servidor do jogo guarda jogadores, carteiras, compras, chat, DMs e sessões.
# Sem MONGODB_URI, os dados ficam só em memória (somem ao reiniciar).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lero
